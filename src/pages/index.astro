---
import '@fontsource-variable/inclusive-sans';
import PodcastCard from '../components/PodcastCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { sortedFeedItems } from '../scripts';

const variants = ['one', 'two', 'three'];
---

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    font-family: 'Inclusive Sans Variable', sans-serif;
    background-color: #fffadc;
  }
  header {
    background-color: #ff4f0f;
    display: flex;

    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    z-index: 99;
  }

  h1 {
    font-weight: 400;
    margin-left: 20px;
  }

  main {
    margin-top: 80px;
  }

  ul {
    padding: 0;
    list-style: none;
    display: grid;

    grid-template-columns: repeat(4, 25%);
    grid-auto-rows: 300px;
    margin: 0;
  }
</style>

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />

    <title>vonkoRSS</title>
  </head>
  <body>
    <header>
      <h1>vonkoRSS:Podcasts</h1>
      <SearchBar />
    </header>
    <main>
      <ul id='podcasts'>
        {
          sortedFeedItems.map((item) => (
            <PodcastCard
              item={item}
              class={`${variants[Math.floor(Math.random() * variants.length)]}`}
            />
          ))
        }
      </ul>
    </main>
  </body>
</html>
